node_modules/
.env

# build output and local snapshots of earlier designs
dist/
releases/

# caches and logs
data/voice/
data/*.log
data/*.err
data/last-run.json

# one-off edit scripts used while building the pages, and machine-specific setup
scripts/apply-*.js
scripts/patch-*.js
scripts/tune-face-v*.js
scripts/add-static-launch.js
scripts/fix-launch.js
scripts/make-env.js
scripts/rename-atropos.js
