# Copy to .env and fill in what you have. Everything is optional: without a key the
# matching feature falls back (sample portfolio, saved odds, text only), and keys are
# never sent to the browser.

# SnapTrade, read-only brokerage holdings (Robinhood, Fidelity). Without it: a sample portfolio.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Jev (TypeSafe), checks every sentence against its numbers and classifies tickers.
TYPESAFE_API_KEY=

# SEC EDGAR asks for a contact in the User-Agent (used only for sec.gov, for the 13F benchmark).
SEC_USER_AGENT="Atropos research you@example.com"

# ElevenLabs, so Atty can read her lines aloud. Lines are cached in data/voice/.
ELEVENLABS_API_KEY=
# ATTY_VOICE_ID=          # defaults to Jev's pick in data/voice-jev.json

# Optional: Claude writes the news brief. Without it the news search still works.
ANTHROPIC_API_KEY=

# PORT=4411
# AGENT_EVERY_MIN=10

# The two joined engines, when you run their backends (see README). Without them the snapshots in public/data answer.
# BASIS_URL=http://127.0.0.1:8000
# LEAF_URL=http://127.0.0.1:8001

# Tiger Data / TimescaleDB, to save trades and odds marks. Without it trades go to data/trades.json.
# DATABASE_URL=postgres://user:pass@host:5432/tsdb?sslmode=require

# The trading agent (services/intel; see its README). It reads ANTHROPIC_API_KEY and SEC_USER_AGENT above too.
# INTEL_URL=http://127.0.0.1:8002          # where `python -m intel serve` listens; atropos proxies it at /api/intel/
# ATROPOS_URL=http://127.0.0.1:4411        # where the agent reads your Fidelity holdings (this server's /api/portfolio)
# INTEL_MODEL=claude-opus-5-5
# Alpaca, only if policy.toml says broker = "alpaca". Paper trading unless ALPACA_LIVE=1 AND allow_live = true.
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# ALPACA_LIVE=
# INTEL_KILL=1                             # stop all trading
